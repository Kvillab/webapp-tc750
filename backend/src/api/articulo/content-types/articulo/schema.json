{
  "kind": "collectionType",
  "collectionName": "articulos",
  "info": {
    "singularName": "articulo",
    "pluralName": "articulos",
    "displayName": "Articulo (Explora y Aprende)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titulo": {
      "type": "string"
    },
    "descripcion": {
      "type": "text"
    },
    "contenido": {
      "type": "blocks"
    },
    "portada": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "fechaPublicacion": {
      "type": "datetime"
    },
    "categoria": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::categoria.categoria"
    },
    "autor": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::autor.autor"
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo"
    }
  }
}
